---
import { Icon } from 'astro-icon/components'

interface Props {
  initialCount?: number
}

const { initialCount = 0 } = Astro.props
---

<!-- <Icon name="mdi:home" /> -->
<Icon name="ion:language" />
<Icon name="ion:bar-chart-outline" />

<div class="stats shadow" x-data={`{ count: ${initialCount} }`}>
  <div class="stat">
    <button x-on:click="count--">-</button>
    <pre class="stat-value" x-text="count">{ initialCount }</pre>
    <button x-on:click="count++">+</button>
  </div>
</div>

<div class="counter-message">
  <slot />
</div>

<div
  x-data="{
      users : [],
      loadUsers() {
        this.users = [
          { id: 1, name: 'John Doe sdfsd' },
          { id: 2, name: 'Jane Smith sdfsd' }
        ]
      }
    }"
>
  <button @click="loadUsers()">Load Users</button>

  <template x-for="user in users" :key="user.id">
    <div x-text="user.name"></div>
  </template>
</div>
