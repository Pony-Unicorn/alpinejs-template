---
import '../app.css'
import { SEO } from 'astro-seo'
import Toaster from '../components/Toaster.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
export interface Props {
  title?: string
  description?: string
}

const {
  title = 'Swift',
  description = 'A lightweight web starter template built with Astro, Alpine.js, Tailwind CSS, and daisyUI.'
} = Astro.props
---

<html lang="en" data-theme="coffee">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <SEO title={title} description={description} />
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content">
    <Navbar />

    <!-- 核心主体内容区：flex-1 撑满剩余高度实现页脚沉底，统一版心与内边距 -->
    <main class="flex-1 w-full mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <Footer />

    <Toaster />

    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
